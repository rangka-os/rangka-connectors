# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/connector.json
# Moka POS (GoTo): transactions, refunds, outlets and items through the Moka Connect API with OAuth 2.0
# (authorization code; the owner approves Juragan in Moka Backoffice).
# Status: spec. API access needs Moka's approval of the integration (developer application at Moka); the paths
# below follow Moka's published API reference and must be confirmed once access is granted. Until then, rangka-apps
# imports the Item Details export (modules/outlet_sales/imports/moka_item_details), whose headers were checked against
# real exports.
# fixtures/ are synthetic (no merchant data): two outlets of the demo F&B shop. The checkouts fields (sku, quantity,
# total_price, discount_amount, refunded_quantity) follow the API reference as read before access; rangka-apps flow
# moka_transaction_staged reads them, so a rename after access changes the flow and these fixtures together.
name: moka
label: {id: Moka POS}
summary:
  id: Ambil transaksi, refund, outlet dan barang dari kasir Moka.
  en: Pull transactions, refunds, outlets and items from Moka POS.
category: sales
icon: store-2-line
version: 0.1.0
vendor: Moka (GoTo)
docs: https://api.mokapos.com/docs
auth:
  type: oauth2
  fields:
    - name: client_id
      label: {id: Client ID}
    - name: client_secret
      label: {id: Client secret}
      secret: true
    - name: access_token
      label: {id: Access token}
      secret: true
      help: {id: Diisi setelah pemilik menyetujui Juragan di Moka Backoffice}
    - name: refresh_token
      label: {id: Refresh token}
      secret: true
triggers:
  # Moka has no webhook for sales: the kernel polls get_latest_transactions per outlet every 5 minutes (contract 0002
  # §A.1, each:). list_outlets runs first. Moka's public API spec (api.mokapos.com/docs, swagger "MOKA API" 0.2,
  # 6 Mar 2026): since/until are epoch seconds, results come newest first unless reorder_type is ASC, there is no page
  # parameter (the answer's next_url is the next page), time_filter picks created_at, updated_at or synchronized_at.
  # In its example a refund made after the sale shows in payment_refunds and in the checkout's refunded_quantity while
  # updated_at stays the sale's time; synchronized_at is when Moka's server got the transaction (late for offline mode).
  # So every poll reads the whole window again: the transactions Moka's server received (synchronized_at) since two
  # days back, newest first, with no cursor.
  # - A transaction that did not change emits the same event, which the kernel drops (the event key is the hash of
  #   what is emitted, kept 30 days); a refunded one emits a new event (payment_refunds, refunded_quantity), and flow
  #   moka_transaction_staged (rangka-apps) books only the quantity refunded since, per checkout uuid.
  # - A sale synced late from offline mode comes in with its sync time, inside the window.
  # - LIMIT until the kernel follows next_url (rangka-os card): one call reads the newest 100 of the window only. More
  #   than 100 transactions per outlet between two polls lose the oldest of them, and a refund of a transaction past
  #   the newest 100 is not seen. With next_url followed the whole window is read and nothing in it is lost; a refund
  #   made more than two days after the sale is outside the window either way (head office books it, or the export).
  #   An outlet moves from the export file to the API only after that kernel card (Juragan PROGRESS, audit moka H3/M1).
  # To confirm once Moka grants API access: synchronized_at for offline sales, the largest per_page, the offset of
  # created_at (flows take the day from its first 10 characters, a Z time as WIB).
  - name: transaction_created
    label: {id: Transaksi baru atau berubah}
    via: poll
    every: 5m
    action: latest_transactions
    each: {action: list_outlets, items: outlets, as: outlet, key: outlet.id}
    input:
      outlet_id: outlet.id
      since: "(days_between('1970-01-01', today()) - 2) * 86400"
      time_filter: "'synchronized_at'"
      reorder_type: "'DESC'"
    for_each: payments[]
    emit:
      transaction_id: item.id
      outlet_id: item.outlet_id
      outlet_name: outlet.name
      receipt_no: item.payment_no
      created_at: item.created_at
      synchronized_at: item.synchronized_at
      is_refunded: item.is_refunded
      refunded_date: item.refunded_date
      # Moka's refunds of this sale (each with its own created_at and refund_amount); the checkouts carry
      # refunded_quantity and a uuid per line
      payment_refunds: item.payment_refunds
      checkouts: item.checkouts
      payment_type: item.payment_type
      total_collected: item.total_collected
actions:
  - name: latest_transactions
    label: {id: Ambil transaksi terbaru}
    request:
      method: GET
      url: https://api.mokapos.com/v3/outlets/{input.outlet_id}/reports/get_latest_transactions
      headers: {Authorization: 'Bearer {auth.access_token}'}
      query: {since: '{input.since}', time_filter: '{input.time_filter}', reorder_type: '{input.reorder_type}', per_page: '100'}
    input:
      - {name: outlet_id, type: data, required: true}
      - {name: since, type: int, required: true, help: {id: 'Detik epoch (UTC)'}}
      - {name: time_filter, type: data, default: "'synchronized_at'", help: {id: 'created_at, updated_at atau synchronized_at'}}
      - {name: reorder_type, type: data, default: "'DESC'", help: {id: 'DESC (terbaru dulu) atau ASC'}}
    output: {payments: data.payments, next: data.next_url}
    retry: {max: 5, backoff: exponential, on: [429, 500, 502, 503]}
  - name: list_outlets
    label: {id: Daftar outlet}
    request:
      method: GET
      url: https://api.mokapos.com/v1/businesses/outlets
      headers: {Authorization: 'Bearer {auth.access_token}'}
    output: {outlets: data}
    retry: {max: 3, backoff: exponential, on: [429, 500, 502, 503]}
  - name: list_items
    label: {id: Daftar barang}
    request:
      method: GET
      url: https://api.mokapos.com/v1/outlets/{input.outlet_id}/items
      headers: {Authorization: 'Bearer {auth.access_token}'}
      query: {per_page: '100', page: '{input.page}'}
    input:
      - {name: outlet_id, type: data, required: true}
      - {name: page, type: int}
    output: {items: data.items}
    retry: {max: 5, backoff: exponential, on: [429, 500, 502, 503]}
limits:
  rate: per Moka partner agreement
  note: {id: 'Akses API Moka lewat persetujuan integrasi dari Moka; ekspor file tetap jalan tanpa akses API'}
